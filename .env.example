# En Vercel estas variables se configuran en Settings → Environment Variables.
# Para pruebas locales, copia este archivo como .env

# Nombre que aparece en el portal y en las constancias
EMPRESA_NOMBRE=DC CONCRETOS

# Contraseña del panel de administración (/admin.html). ¡Usa una segura!
ADMIN_PASSWORD=cambia-esta-contraseña

# Postgres. En Vercel se crea sola al conectar Neon (Storage → Neon).
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/portal

# Vercel Blob (privado). En Vercel se crea sola al conectar el Blob store.
# Si no está definida, los archivos se guardan en la carpeta DATA_DIR (modo local).
# BLOB_READ_WRITE_TOKEN=

# Solo modo local
# PORT=3000
# DATA_DIR=./data
