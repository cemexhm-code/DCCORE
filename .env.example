# Copia este archivo como .env y cambia los valores

# Nombre que aparece en el portal y en las constancias
EMPRESA_NOMBRE=DC CONCRETOS

# Contraseña del panel de administración (/admin.html). ¡Usa una segura!
ADMIN_PASSWORD=cambia-esta-contraseña

# Puerto del servidor
PORT=3000

# Carpeta donde se guardan la base de datos, PDFs, firmas y videos (opcional)
# DATA_DIR=/var/data/portal-politicas
